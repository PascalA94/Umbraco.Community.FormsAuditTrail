{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "5b0e1c6e-3f4a-4d0b-9a57-2c8d7e1f4a90",
        "Smtp": {
          "From": "demo@example.test",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "umbraco/Data/MailPickup"
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {}
    }
  }
}