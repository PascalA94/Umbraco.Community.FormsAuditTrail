<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Community.FormsAuditTrail</RootNamespace>
    <!-- Client assets in wwwroot are served at /App_Plugins/FormsAuditTrail/ via static web assets -->
    <StaticWebAssetBasePath>App_Plugins/FormsAuditTrail</StaticWebAssetBasePath>
    <!-- Audit transitive dependencies too: advisories reached through the Umbraco floors are pinned below -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.FormsAuditTrail</PackageId>
    <Version>18.1.0</Version>
    <Authors>Pascal Meyer</Authors>
    <Description>A view-only audit trail for Umbraco Forms design changes. Tracks who changed what on form designs (fields, pages, workflows and form settings) and surfaces the history in a backoffice dashboard with filtering, field-level diffs and CSV export.</Description>
    <Copyright>Copyright © Pascal Meyer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/PascalA94/Umbraco.Community.FormsAuditTrail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PascalA94/Umbraco.Community.FormsAuditTrail</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-forms;forms;audit;audit-trail;change-tracking;backoffice;plugin;package</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Debugging support: Source Link (built into the .NET SDK) plus a .snupkg symbol package,
       which `dotnet nuget push` uploads alongside the .nupkg -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic, path-normalised builds in CI so published binaries are reproducible -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.2.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="[18.2.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="[18.2.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Forms.Web" Version="[18.1.3, 19.0.0)" />
    <PackageReference Include="Umbraco.Forms.Core.Providers" Version="[18.1.3, 19.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.11, 11.0.0)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Security minimums for transitive packages that the Umbraco floors resolve to vulnerable versions.
       Pinned here so consuming sites resolve the patched versions without raising the Umbraco floors.
       Remove each once the Umbraco floor itself pulls in the patched version. -->
  <ItemGroup>
    <!-- GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 (via MimeKit and Microsoft.Data.SqlClient) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- GHSA-qhrr-8q5h-9q3h (via Umbraco.Cms.Web.Common) -->
    <PackageReference Include="MessagePack" Version="3.1.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <!-- The client source is not package content; only the built wwwroot assets ship -->
    <Content Remove="Client\**" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.FormsAuditTrail.Tests" />
  </ItemGroup>

</Project>
