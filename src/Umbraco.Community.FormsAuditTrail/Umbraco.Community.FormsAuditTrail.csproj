<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Community.FormsAuditTrail</RootNamespace>
    <!-- Client assets in wwwroot are served at /App_Plugins/FormsAuditTrail/ via static web assets -->
    <StaticWebAssetBasePath>App_Plugins/FormsAuditTrail</StaticWebAssetBasePath>
    <!-- Audit transitive dependencies too: the old floors resolved a High Pkcs advisory that "direct" mode could not
         see (SEC-05), and advisories reached through the Umbraco floors are pinned below. Level low reports every
         severity, matching the build/check-vulnerable gate. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.FormsAuditTrail</PackageId>
    <!-- MSBuild adds the hyphen only when the suffix is non-empty, so a stable release (empty suffix) is a valid version. -->
    <VersionPrefix>$(UmbracoMajor).$(PackageMinor).$(PackagePatch)</VersionPrefix>
    <VersionSuffix>$(PackageVersionSuffix)</VersionSuffix>
    <Authors>Pascal Meyer</Authors>
    <Description>A view-only audit trail for Umbraco Forms. Records who changed what on form designs (fields, pages, workflows and form settings), and who viewed, searched, exported, downloaded, edited or deleted form entries, with field-level edit history and delete capture. The history is shown in backoffice dashboards with filtering, diffs and CSV export, and the entry access log is limited to named user groups.</Description>
    <Copyright>Copyright © Pascal Meyer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/PascalA94/Umbraco.Community.FormsAuditTrail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PascalA94/Umbraco.Community.FormsAuditTrail</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-forms;forms;audit;audit-trail;change-tracking;backoffice;umbracopackage;gdpr;compliance;entries;umbraco-forms-entries</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Debugging support: Source Link (built into the .NET SDK) plus a .snupkg symbol package,
       which `dotnet nuget push` uploads alongside the .nupkg -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic, path-normalised builds in CI so published binaries are reproducible -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Floors come from Directory.Build.props (17.8.0 / 18.3.0 CMS, 17.6.2 / 18.2.2 Forms): the portfolio floors that
       cover the October 2026 security rounds. Forms 18.2.2 and 17.6.2 are security releases and ship the controllers the
       audit matches, so they are the lowest Forms versions the audit can rely on. Never lower them without a security
       review. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoRange)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="$(UmbracoRange)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="$(UmbracoRange)" />
    <PackageReference Include="Umbraco.Forms.Web" Version="$(FormsRange)" />
    <PackageReference Include="Umbraco.Forms.Core.Providers" Version="$(FormsRange)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.11, 11.0.0)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Line 17 only: Forms 17 alone requires CMS 17.5, whose Swashbuckle pulls a vulnerable Microsoft.OpenApi
       (GHSA-v5pm-xwqc-g5wc). Referencing Umbraco.Cms.Api.Management at the CMS range lifts it. Line 18 does not need it,
       so its dependency graph is unchanged. -->
  <ItemGroup Condition="'$(UmbracoMajor)' == '17'">
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoRange)" />
  </ItemGroup>

  <!-- Pinned so the package never resolves Pkcs <= 10.0.12 (GHSA-846f-f764-76mx High, GHSA-2fmv-rv2c-59x7) or
       MessagePack < 3.1.9 (GHSA-qhrr-8q5h-9q3h), whatever Umbraco's transitive graph does. MessagePack is 3.1.11
       because the CMS floors (17.8.0 and 18.3.0) already need it (a lower direct floor raises NU1605). Remove a pin only when every
       supported CMS floor resolves the patched version itself and CI's transitive audit is green without it.
       MessagePack takes a plain minimum, not a range: osv-scanner reads "[3.1.11, 4.0.0)" as a literal version and
       matches advisories fixed in 1.x and 2.x. NuGet treats "3.1.11" as ">= 3.1.11", so the floor is the same. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.13, 11.0.0)" />
    <PackageReference Include="MessagePack" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <!-- The client source is not package content; only the built wwwroot assets ship -->
    <Content Remove="Client\**" />
    <!-- The per-line lock files sit next to the project and the Razor SDK would otherwise pack them. -->
    <Content Remove="packages.*.lock.json" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.FormsAuditTrail.Tests" />
    <!-- NSubstitute's proxies are emitted into this dynamic assembly. The capture pipeline's services are internal so
         they are not public API, and the tests still need to substitute them. Internals are not a security boundary
         in .NET, so this grants nothing that reflection does not already allow. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
