<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Community.FormsAuditTrail</RootNamespace>
    <!-- Client assets in wwwroot are served at /App_Plugins/FormsAuditTrail/ via static web assets -->
    <StaticWebAssetBasePath>App_Plugins/FormsAuditTrail</StaticWebAssetBasePath>
    <!-- Audit transitive dependencies too: the old floors resolved a High Pkcs advisory that "direct" mode could not
         see (SEC-05), and advisories reached through the Umbraco floors are pinned below. Level low reports every
         severity, matching the build/check-vulnerable gate. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.FormsAuditTrail</PackageId>
    <Version>17.0.5</Version>
    <Authors>Pascal Meyer</Authors>
    <Description>A view-only audit trail for Umbraco Forms design changes. Tracks who changed what on form designs (fields, pages, workflows and form settings) and surfaces the history in a backoffice dashboard with filtering, field-level diffs and CSV export.</Description>
    <Copyright>Copyright © Pascal Meyer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/PascalA94/Umbraco.Community.FormsAuditTrail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PascalA94/Umbraco.Community.FormsAuditTrail</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-forms;forms;audit;audit-trail;change-tracking;backoffice;plugin;package</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Debugging support: Source Link (built into the .NET SDK) plus a .snupkg symbol package,
       which `dotnet nuget push` uploads alongside the .nupkg -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic, path-normalised builds in CI so published binaries are reproducible -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Floors come from Directory.Build.props (UmbracoCmsVersion, UmbracoFormsVersion) so CI's latest leg can lift them.
       CMS 17.8.0 and Forms 17.6.2 are the portfolio floors; Forms 17.6.2 needs CMS [17.6.0, 18.0.0), so 17.8.0 is in range.
       Umbraco.Cms.Api.Management stays on the CMS version: Forms 17 alone only requires 17.5, whose Swashbuckle pulls a
       vulnerable Microsoft.OpenApi (GHSA-v5pm-xwqc-g5wc). -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Forms.Web" Version="$(UmbracoFormsVersion)" />
    <PackageReference Include="Umbraco.Forms.Core.Providers" Version="$(UmbracoFormsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.11, 11.0.0)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Pinned so the package never resolves Pkcs <= 10.0.12 (GHSA-846f-f764-76mx High, GHSA-2fmv-rv2c-59x7) or
       MessagePack < 3.1.9 (GHSA-qhrr-8q5h-9q3h), whatever Umbraco's transitive graph does. MessagePack is 3.1.11
       because the CMS floor already needs it (a lower direct floor raises NU1605). Remove a pin only when every
       supported CMS floor resolves the patched version itself and CI's transitive audit is green without it.
       MessagePack takes a plain minimum, not a range: osv-scanner reads "[3.1.11, 4.0.0)" as a literal version and
       matches advisories fixed in 1.x and 2.x. NuGet treats "3.1.11" as ">= 3.1.11", so the floor is the same. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.13, 11.0.0)" />
    <PackageReference Include="MessagePack" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <!-- The client source is not package content; only the built wwwroot assets ship -->
    <Content Remove="Client\**" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.FormsAuditTrail.Tests" />
  </ItemGroup>

</Project>
