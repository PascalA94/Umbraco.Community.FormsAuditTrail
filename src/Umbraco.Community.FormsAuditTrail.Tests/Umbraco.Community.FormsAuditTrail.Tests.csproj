<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Match the package project: audit transitive dependencies too -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj. The package project prunes this
         (it ships in the ASP.NET Core shared framework, patched by the runtime), but this project does not -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The package declares Umbraco and Forms as ranges and resolves to their floors. These direct references keep the
       tests at the floor by default and let the CI latest leg lift them to the newest 18.x (Directory.Build.props). -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoTestVersion)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="$(UmbracoTestVersion)" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="$(UmbracoTestVersion)" />
    <PackageReference Include="Umbraco.Forms.Web" Version="$(FormsTestVersion)" />
    <PackageReference Include="Umbraco.Forms.Core.Providers" Version="$(FormsTestVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.FormsAuditTrail\Umbraco.Community.FormsAuditTrail.csproj" />
  </ItemGroup>

</Project>
