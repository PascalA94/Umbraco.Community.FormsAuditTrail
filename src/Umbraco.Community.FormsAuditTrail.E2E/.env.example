# Copy to .env (git-ignored) and fill in. Nothing here is a real value.

# The demo site under test. Self-signed development certificate, so HTTPS errors are ignored by the config.
E2E_BASE_URL=https://localhost:44371

# Backoffice administrator created by the demo site's unattended install.
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=

# The restricted users the seed creates. The same value must be passed to the site as E2E__EditorPassword.
E2E_EDITOR_EMAIL=e2e.editor@example.com
E2E_EDITOR_PASSWORD=

# An access-log user (group e2eAuditors) who sees only E2E Contact and is outside the Sensitive data group.
# The same value must be passed to the site as E2E__AuditorPassword.
E2E_AUDITOR_EMAIL=e2e.auditor@example.com
E2E_AUDITOR_PASSWORD=

# Set to 1 once the access-log API is merged: a missing /access route then fails the suite instead of skipping.
E2E_EXPECT_ACCESS_API=

# Start the demo site for these specs with (Development only; each flag is read from configuration and is off by default):
#   ASPNETCORE_ENVIRONMENT=Development
#   E2E__Seed=true
#   E2E__Diagnostics=true
#   E2E__SimulateEncryption=true
#   E2E__EditorPassword=<same as E2E_EDITOR_PASSWORD>
#   E2E__AuditorPassword=<same as E2E_AUDITOR_PASSWORD>
#   FormsAuditTrail__EntryAudit__AccessLogUserGroups__0=admin
#   FormsAuditTrail__EntryAudit__AccessLogUserGroups__1=e2eAuditors
#   FormsAuditTrail__EntryAudit__DeduplicateSeconds=0   (so every list and detail view writes its own row)
#   Umbraco__CMS__DeliveryApi__Enabled=true                      (the workflow spec submits one entry through the
#   Umbraco__Forms__Options__EnableFormsApi=true                  Forms Delivery API, because only a front-end
#   Umbraco__Forms__Security__EnableAntiForgeryTokenForFormsApi=false  submission runs the form's workflows)
# The anti-forgery switch above is for a local Development run only. Never set it on a deployed site.
