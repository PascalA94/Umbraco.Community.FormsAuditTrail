<Project>
  <!--
    Floor versions for the demo site. They match the minimums the package supports, so the demo
    exercises the oldest supported Umbraco and Forms. Override on the command line
    (-p:UmbracoDemoVersion=...) to try a newer minor.
  -->
  <PropertyGroup>
    <UmbracoDemoVersion Condition="'$(UmbracoDemoVersion)' == ''">17.7.0</UmbracoDemoVersion>
    <FormsDemoVersion Condition="'$(FormsDemoVersion)' == ''">17.5.2</FormsDemoVersion>
  </PropertyGroup>
</Project>
