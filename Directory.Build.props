<Project>
  <!--
    Lock files describe the floor: they are generated and committed at the default values below, and the floor CI
    leg restores in locked mode. The latest CI leg overrides all four properties with 17.* and restores unlocked
    (force-evaluate, RestoreLockedMode=false); the lock files it rewrites are never committed.
    The defaults match the package's minimum Umbraco and Forms versions, so tests and the demo run at the floor.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UmbracoTestVersion Condition="'$(UmbracoTestVersion)' == ''">17.7.0</UmbracoTestVersion>
    <FormsTestVersion Condition="'$(FormsTestVersion)' == ''">17.5.2</FormsTestVersion>
    <UmbracoDemoVersion Condition="'$(UmbracoDemoVersion)' == ''">17.7.0</UmbracoDemoVersion>
    <FormsDemoVersion Condition="'$(FormsDemoVersion)' == ''">17.5.2</FormsDemoVersion>
  </PropertyGroup>
</Project>
